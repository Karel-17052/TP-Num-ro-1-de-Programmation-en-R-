\textcolor{MidnightBlue}{\subsection{Calculs}}
 
 Déterminez les rendements mensuels moyens et la matrice de covariance entre les actifs

3.1.1 Rendements mensuels

```{r,echo=TRUE,comment="",warning=FALSE,message=FALSE}
# Calcul des rendements mensuels
rendements <- prix_mensuels %>%
group_by(symbol) %>%
tq_transmute(select = adjusted,
mutate_fun = periodReturn,
period = "monthly",
type = "arithmetic",
col_rename = "rendement") %>%
mutate(rendement = rendement * 100)

# Rendements mensuels moyens
rendements_moyens <- rendements %>%
group_by(symbol) %>%
summarise(
rendement_moyen = mean(rendement),
volatilite = sd(rendement),
sharpe = rendement_moyen / volatilite
) %>%
arrange(desc(rendement_moyen))

knitr::kable(rendements_moyens, 
caption = "Rendements mensuels (moyens
) et volatilités (2019-2026)",
digits = 2)
```

3.1.2 Matrice de covariance

```{r,echo=TRUE,comment="",warning=FALSE,message=FALSE}
# Transformation en format large
rendements_large <- rendements %>%
select(symbol, date, rendement) %>%
pivot_wider(names_from = symbol,
            values_from = rendement)

# Matrice de covariance
cov_matrix <- rendements_large %>%
select(-date) %>%
cov(use = "complete.obs")
```


