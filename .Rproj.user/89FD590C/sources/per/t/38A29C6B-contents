\textcolor{MidnightBlue}{\subsection{Optimisation - Frontière efficiente}}

Objectif : Déterminez la frontière efficiente via R ou Excel.

\begin{center}
\renewcommand{\arraystretch}{1.4}
\begin{tabularx}{\linewidth}{|X|X|}
\hline
\rowcolor{darkblue}
\color{white}\textbf{Concept} & \color{white}\textbf{Formule} \\[2pt]
\hline
\rowcolor{gray!10} Rendement simple & $R_{i,t} = \dfrac{P_{i,t}}{P_{i,t-1}} - 1$ \\[2pt]
\hline
\rowcolor{white} Rendement logarithmique & $r_{i,t} = \ln\left(\dfrac{P_{i,t}}{P_{i,t-1}}\right)$ \\[2pt]
\hline
\rowcolor{gray!10} Rendement moyen & $\bar{R}_i = \dfrac{1}{T} \sum_{t=1}^{T} R_{i,t}$ \\[2pt]
\hline
\rowcolor{white} Variance & $\sigma_i^2 = \dfrac{1}{T-1} \sum_{t=1}^{T} (R_{i,t} - \bar{R}_i)^2$ \\[2pt]
\hline
\rowcolor{gray!10} Covariance & $\sigma_{ij} = \dfrac{1}{T-1} \sum_{t=1}^{T} (R_{i,t} - \bar{R}_i)(R_{j,t} - \bar{R}_j)$ \\[2pt]
\hline
\rowcolor{white} Corrélation & $\rho_{ij} = \dfrac{\sigma_{ij}}{\sigma_i \sigma_j}$ \\[2pt]
\hline
\rowcolor{gray!10} Rendement portefeuille & $E(R_p) = \mathbf{w}^T \mathbf{\bar{R}}$ \\[2pt]
\hline
\rowcolor{white} Variance portefeuille & $\sigma_p^2 = \mathbf{w}^T \Sigma \mathbf{w}$ \\[2pt]
\hline
\end{tabularx}
\end{center}

4.1.1 Construction de la frontière efficiente avec fPortfolio

```{r,echo=TRUE,comment="",warning=FALSE,message=FALSE}
# Convertir en timeSeries
rendements_ts <- as.timeSeries(
  rendements_large %>% select(-date))

# Spécification du portefeuille
spec <- portfolioSpec()
setSolver(spec) <- "solveRquadprog"

# Contraintes (pas de vente à découvert)
constraints <- "LongOnly"

# Calcul de la frontière efficiente
frontier <- portfolioFrontier(
rendements_ts, spec, constraints)

# Visualisation de la frontière
plot(frontier, which = 1,
main = "Frontière Efficiente de Markowitz")
plot(frontier, which = 3,
main = "Frontière Efficiente avec points")
```

4.1.2 Extraction des portefeuilles optimaux

```{r,echo=TRUE,comment="",warning=FALSE,message=FALSE}
# Portefeuille à risque minimal
min_risk_portfolio <- minvariancePortfolio(
  rendements_ts, spec, constraints)

# Portefeuille tangents (Sharpe maximal)
# Taux sans risque mensuel (3% annualisé)
rf_monthly <- 0.03 / 12

spec_tangent <- portfolioSpec()
setSolver(spec_tangent) <- "solveRquadprog"
setRiskFreeRate(spec_tangent) <- rf_monthly 

# Calcul du portefeuille tangent
tangent_portfolio <- tangencyPortfolio(
rendements_ts, spec_tangent, constraints)

```

4.1.3 Poids des portefeuilles optimaux

```{r,echo=TRUE,comment="",warning=FALSE,message=FALSE}
# Poids du portefeuille à risque minimal
weights_min_risk <- getWeights(
  min_risk_portfolio)
poids_min_risk <- data.frame(
  Actif = tickers,
  Poids = round(as.numeric(
    weights_min_risk) * 100, 2)
) %>% arrange(desc(Poids))

# Poids du portefeuille tangent
weights_tangent <- getWeights(
tangent_portfolio)
poids_tangent <- data.frame(
Actif = tickers,
Poids = round(as.numeric(
weights_tangent) * 100, 2)
) %>% arrange(desc(Poids))

# Affichage
