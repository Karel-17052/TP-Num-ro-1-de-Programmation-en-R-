 4. Fonction de backtesting

```{r,echo=TRUE,comment=""}
# Fonction de simulation de trading
backtest_strategy <- function(data, signal_achat,
  signal_vente,capital_initial = 100000) {
  n <- nrow(data)
  position <- 0
  capital <- capital_initial
  actif <- capital_initial
  transactions <- data.frame()
  
  for (i in 1:n) {
    prix <- data$close[i]
    date_courante <- data$date[i]
    
    # Signal d'achat
    if (position == 0 && signal_achat[i]) {
      qte <- floor(capital / prix)
      frais <- qte * prix * 0.0015  
      # 0.15% frais + slippage
      capital <- capital - qte * prix - frais
      position <- qte
      transactions <- rbind(transactions, 
      data.frame(date = date_courante,
      type = "ACHAT", 
      prix = prix, qte = qte))
    }
    
    # Signal de vente
    else if (position > 0 && signal_vente[i]) {
      frais <- position * prix * 0.0015
      capital <- capital + position * prix - frais
      position <- 0
      transactions <- rbind(transactions, 
      data.frame(date = date_courante,
      type = "VENTE", prix = prix,
      qte = position))
    }
    
    # Valeur du portefeuille
    actif[i] <- capital + position * prix
  }
  
  perf <- (tail(actif, 1) - capital_initial) 
  perf <- perf/ capital_initial * 100
  
  n_transactions <- nrow(transactions)
  
  return(list(actif = actif, perf = perf,
              n_transactions = n_transactions, 
              transactions = transactions,
              capital_final = tail(actif, 1)))
}
```



