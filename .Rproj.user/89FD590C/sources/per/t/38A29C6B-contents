```{r,echo=TRUE,eval=FALSE,comment="",warning=FALSE,message=FALSE,output="axis"}
# Import yfinance
yf <- import("yfinance")

get_info_robust <- function(ticker,
max_retries = 3) {
for (attempt in 1:max_retries) {
tryCatch({
  # Petite pause pour éviter de surcharger l'API
  Sys.sleep(0.5)
  
  # Récupérer le ticker
  tkr <- yf$Ticker(ticker)
  
  # Récupérer les informations
  info <- py_to_r(tkr$info)
  
  # Extraire les valeurs avec gestion des NULL
  per <- ifelse(is.null(info[["trailingPE"]])
      , NA, as.numeric(info[["trailingPE"]]))
  div_yield <- ifelse(
    is.null(info[["dividendYield"]])
      , NA, as.numeric(info[["dividendYield"]]))
  roe <- ifelse(is.null(info[["returnOnEquity"]])
      , NA, as.numeric(info[["returnOnEquity"]]))
  # Retourner le résultat
  return(data.frame(
    Ticker = ticker,
    PER = per,
    DividendYield = div_yield,
    ROE = roe,
    stringsAsFactors = FALSE
  ))
  
}, error = function(e) {
if (attempt == max_retries) {
warning(paste("Échec pour", ticker,
"après", max_retries, "tentatives:", e$message))
return(data.frame(
  Ticker = ticker,
  PER = NA,
  DividendYield = NA,
  ROE = NA,
  stringsAsFactors = FALSE
))
  } else {
    # Attendre avant de réessayer
    Sys.sleep(2)
    return(NULL)
  }
})
}
}

