y+as.integer(unlist(w))
y+as.integer(w)
knitr::opts_chunk$set(
echo      = TRUE,
eval      = TRUE,
comment   = "##",
prompt    = FALSE,
warning   = FALSE,
message   = FALSE,
fig.align = "center",
fig.height = 3.2,
fig.width  = 5.5,
size      = "small"
)
as.numeric(c("10", "A", "20"))
x <- c("10", "A", "20")
y <- as.numeric(c("10", "A", "20"))
x[is.na(y)]
cat(probleme "n'est pas un nombre")
cat(probleme & "n'est pas un nombre")
probleme <- x[is.na(y)]
cat(probleme & "n'est pas un nombre")
cat(probleme "n'est pas un nombre")
cat(probleme, "n'est pas un nombre")
indice <- which(is.na(y))
cat(probleme, " qui est dans x à la position ", indice, " n'est pas un nombre")
x <- c("10", "A", "20","B")
y <- as.numeric(x)
probleme <- x[is.na(y)]
indice <- which(is.na(y))
cat(probleme, " qui est dans x à la position ", indice, " n'est pas un nombre")
