as.numeric(z) + x
unlist(w) + x
knitr::opts_chunk$set(
echo = TRUE,        # affiche le code R
results = 'markup', # affiche les résultats texte
warning = FALSE,    # cache les avertissements
message = FALSE,    # cache les messages
fig.show = 'asis',  # affiche les graphiques à leur position
fig.width = 7,      # largeur des graphiques (en pouces)
fig.height = 5,      # hauteur des graphiques (en pouces)
comment = NA
)
x <- c(1, 2, 3)
x <- c(1, 2, 3)
y <- c(TRUE, FALSE, TRUE)
